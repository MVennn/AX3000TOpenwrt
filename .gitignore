# ---------------------------------------------------------------------------
# AX3000TOpenwrt —— 版本控制忽略规则
#
# 原则：**源码与文档一律入库**（.sh / .md / .yaml / .nft / .ps1 / .cmd 都留）。
#       只排除「凭据」「大体积备份包」「一次性产物」「本地私有材料」。
#       凭据的读取方式与轮换建议见 docs/SECRETS.md。
# ---------------------------------------------------------------------------

# --- 凭据与私钥 ----------------------------------------------------------
*.key
*.key.orig
*.crt
*.crt.orig
*.pem
*.p12
*.pfx
*.conf.bak
*.wg.conf
wg-*.conf
.env
.env.*
# 本机 root 口令文件（askpass.sh 的本地回退来源）
.router-password
**/.router-password

# --- 订阅与节点凭据 ------------------------------------------------------
# 机场订阅原文、解码结果、节点清单（含 vmess uuid）
/evidence/subscription/
*.sub
sub.raw
sub-decoded.txt
sub-nodes.txt
proxies.json
generated-config.yaml

# --- 备份与升级包 --------------------------------------------------------
# 含 etc/shadow / SSH 主机私钥 / HTTPS 私钥，且体积大
*.tar.gz
*.tar.gz.enc
*.tar
*.tgz
*.zip
*.7z
/router-pre-*/
/pre-*/
*.apk-new

# --- 日志与运行时残留 ----------------------------------------------------
*.log
*.log.*
*.pid
*.sock
*.tmp
*.swp
*~
.DS_Store
Thumbs.db

# --- 构建与工具残留 ------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
node_modules/
dist/
build/
.cache/
.mypy_cache/
.pytest_cache/

# --- 本地索引与编辑器 ----------------------------------------------------
.codegraph/
.idea/
.vscode/
*.code-workspace

# --- 私有材料（绝不入库） ------------------------------------------------
# vault/：不可再生的回退材料（私钥、整机快照、主题恢复包）
/vault/
# .work/：临时产物、脱敏发布快照、私有证据与完整历史 bundle
/.work/
